exports[`FileProcessor regular files > translates user-facing strings in runtime const objects 1`] = `
"const UI_LABELS = {
  save: "{{ $t('common.test.save') }}",
  cancel: "{{ $t('common.test.cancel') }}",
} as const

export function getActionLabel(kind: 'save' | 'cancel') {
  return UI_LABELS[kind]
}
"
`;
