    "@lokalise/node-api": "^15.6.1",
    "@mistralai/mistralai": "^1.15.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vue/compiler-dom": "^3.5.30",
    "@vue/compiler-sfc": "^3.5.30",
    "@yandex-cloud/nodejs-sdk": "^2.8.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "baidu-translate-service": "^2.2.4",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cohere-ai": "^7.20.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "deepl-node": "^1.24.0",
