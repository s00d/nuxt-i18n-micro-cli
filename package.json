{
  "name": "nuxt-i18n-micro-cli",
  "version": "2.1.2",
  "description": "⚡️ nuxt-i18n-micro-cli CLI Experience",
  "repository": "s00d/nuxt-i18n-micro-cli",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./bin/i18n.mjs"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "i18n-micro": "./bin/i18n.mjs",
    "i18n-micro-cli": "./bin/i18n.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev:prepare": "pnpm build",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:stub": "pnpm build",
    "dev": "node ./bin/i18n.mjs",
    "dev:bun": "bun --bun ./bin/i18n.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "i18n": "node ./bin/i18n.mjs",
    "i18n-bun": "bun --bun ./bin/i18n.mjs",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint && vitest run && pnpm test:types && pnpm build && pnpm test:dist",
    "test:dist": "node ./bin/i18n.mjs -h",
    "test:types": "tsc --noEmit",
    "docs": "npx tsx ./scripts/generate-docs.ts"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/kit": "^4.4.5",
    "@nuxt/schema": "^4.4.5",
    "@nuxt/test-utils": "^4.0.3",
    "@types/dlv": "^1.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/gettext-parser": "^9.0.0",
    "@types/node": "^20.19.37",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.6",
    "changelogen": "^0.6.2",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "eslint": "^10.4.0",
    "nuxt": "^4.4.5",
    "pathe": "^2.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.9"
  },
  "optionalDependencies": {
    "fsevents": "~2.3.3"
  },
  "resolutions": {
    "nuxt": "^4.4.5"
  },
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": "^16.10.0 || >=18.0.0"
  },
  "dependencies": {
    "@azure-rest/ai-translation-text": "^1.0.1",
    "@crowdin/crowdin-api-client": "^1.55.1",
    "@gitbeaker/rest": "^43.8.0",
    "@inquirer/prompts": "^8.4.3",
    "@lokalise/node-api": "^15.7.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vue/compiler-dom": "^3.5.34",
    "@vue/compiler-sfc": "^3.5.34",
    "@yandex-cloud/nodejs-sdk": "^2.8.0 <2.9.0",
    "ai": "^6.0.184",
    "archiver": "^8.0.0",
    "axios": "^1.16.1",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "deepl-node": "^1.27.0",
    "defu": "^6.1.7",
    "dlv": "^1.1.3",
    "dset": "^3.1.4",
    "extract-zip": "^2.0.1",
    "fast-glob": "^3.3.3",
    "flat": "^6.0.1",
    "fs-extra": "^11.3.5",
    "gettext-parser": "^9.0.2",
    "libretranslate-ts": "^0.5.12",
    "log-symbols": "^7.0.1",
    "magic-string": "^0.30.21",
    "mlly": "^1.8.2",
    "modernmt": "^1.5.3",
    "octokit": "^5.0.5",
    "ora": "^9.4.0",
    "oxc-parser": "^0.131.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "p-timeout": "^7.0.1",
    "picomatch": "^4.0.4",
    "pretty-bytes": "^7.1.0",
    "pretty-ms": "^9.3.0",
    "scule": "^1.3.0",
    "table": "^6.9.0",
    "ufo": "^1.6.4",
    "zod": "^4.4.3"
  }
}
