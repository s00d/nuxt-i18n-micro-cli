{
  "name": "nuxt-i18n-micro-cli",
  "version": "1.2.0",
  "description": "⚡️ nuxt-i18n-micro-cli CLI Experience",
  "repository": "s00d/nuxt-i18n-micro-cli",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./bin/i18n.mjs"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "i18n-micro": "./bin/i18n.mjs",
    "i18n-micro-cli": "./bin/i18n.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev:prepare": "unbuild --stub",
    "build": "unbuild",
    "build:stub": "unbuild --stub",
    "dev": "node ./bin/i18n.mjs",
    "dev:bun": "bun --bun ./bin/i18n.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "i18n": "node ./bin/i18n.mjs",
    "i18n-bun": "bun --bun ./bin/i18n.mjs",
    "prepack": "unbuild",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint && vitest run && pnpm test:types && pnpm build && pnpm test:dist",
    "test:dist": "node ./bin/i18n.mjs -h",
    "test:types": "tsc --noEmit",
    "docs": "npx tsx ./scripts/generate-docs.ts"
  },
  "devDependencies": {
    "@inquirer/prompts": "^7.5.3",
    "@nuxt/eslint-config": "^0.5.5",
    "@nuxt/kit": "^3.13.1",
    "@nuxt/schema": "^3.13.1",
    "@nuxt/test-utils": "^3.15.1",
    "@types/archiver": "^5.3.2",
    "@types/gettext-parser": "^4.0.4",
    "@types/node": "^20.17.10",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^2.1.8",
    "changelogen": "^0.5.7",
    "citty": "^0.1.6",
    "consola": "^3.3.1",
    "eslint": "^9.9.1",
    "mlly": "^1.7.3",
    "nuxt": "^3.13.1",
    "pathe": "^1.1.2",
    "unbuild": "^3.0.1",
    "unplugin-purge-polyfills": "^0.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "optionalDependencies": {
    "fsevents": "~2.3.3"
  },
  "resolutions": {
    "nuxt": "^3.13.1"
  },
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": "^16.10.0 || >=18.0.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "extract-zip": "^2.0.1",
    "gettext-parser": "^8.0.0",
    "glob": "^9.3.5",
    "prompts": "^2.4.2",
    "slugify": "^1.6.6"
  }
}
