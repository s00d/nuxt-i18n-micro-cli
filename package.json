{
  "name": "nuxt-i18n-micro-cli",
  "version": "2.0.1",
  "description": "⚡️ nuxt-i18n-micro-cli CLI Experience",
  "repository": "s00d/nuxt-i18n-micro-cli",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./bin/i18n.mjs"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "i18n-micro": "./bin/i18n.mjs",
    "i18n-micro-cli": "./bin/i18n.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev:prepare": "pnpm build",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:stub": "pnpm build",
    "dev": "node ./bin/i18n.mjs",
    "dev:bun": "bun --bun ./bin/i18n.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "i18n": "node ./bin/i18n.mjs",
    "i18n-bun": "bun --bun ./bin/i18n.mjs",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint && vitest run && pnpm test:types && pnpm build && pnpm test:dist",
    "test:dist": "node ./bin/i18n.mjs -h",
    "test:types": "tsc --noEmit",
    "docs": "npx tsx ./scripts/generate-docs.ts"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/kit": "^4.3.1",
    "@nuxt/schema": "^4.3.1",
    "@nuxt/test-utils": "^4.0.0",
    "@types/archiver": "^7.0.0",
    "@types/dlv": "^1.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/gettext-parser": "^9.0.0",
    "@types/node": "^20.19.37",
    "@types/picomatch": "^4.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "changelogen": "^0.6.2",
    "citty": "^0.2.1",
    "consola": "^3.4.2",
    "eslint": "^10.0.3",
    "mlly": "^1.8.1",
    "nuxt": "^4.3.1",
    "pathe": "^2.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  },
  "optionalDependencies": {
    "fsevents": "~2.3.3"
  },
  "resolutions": {
    "nuxt": "^4.3.1"
  },
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": "^16.10.0 || >=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
